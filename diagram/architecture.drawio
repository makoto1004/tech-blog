<mxfile host="make-diagram.js" type="device"><diagram id="aws" name="構成図"><mxGraphModel dx="1260" dy="840" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="840" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="技術ブログの土台：Hugo のページを S3 + CloudFront で配信する構成（Terraform）" style="text;html=0;whiteSpace=wrap;fontFamily=Yu Gothic;fontSize=24;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1180" height="36" as="geometry"/></mxCell><mxCell id="sub" value="S3 は非公開。CloudFront の OAC からだけ読める。AWS の物はすべて Terraform で作り、state は別の S3 に置く。コードは GitHub（makoto1004/tech-blog）。" style="text;html=0;whiteSpace=wrap;fontFamily=Yu Gothic;fontSize=14;fontColor=#5f6b7a;align=left;verticalAlign=top;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1180" height="24" as="geometry"/></mxCell><mxCell id="users" value="見る人&#xa;（スマホ・PC）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontFamily=Yu Gothic;fontSize=14;aspect=fixed;shape=mxgraph.aws4.users;" vertex="1" parent="1"><mxGeometry x="70" y="220" width="64" height="64" as="geometry"/></mxCell><mxCell id="cloud" value="AWS Cloud" style="points=[];outlineConnect=0;html=0;whiteSpace=wrap;fontFamily=Yu Gothic;fontSize=15;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=34;fontColor=#232F3E;dashed=0;" vertex="1" parent="1"><mxGeometry x="250" y="110" width="960" height="530" as="geometry"/></mxCell><mxCell id="cf" value="CloudFront&#xa;HTTPS へ転送・SecurityHeadersPolicy&#xa;CloudFront Functions（/ → index.html）&#xa;ない所は 404 のページ" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;fillColor=#8C4FFF;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontFamily=Yu Gothic;fontSize=14;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;verticalLabelPosition=top;verticalAlign=bottom;" vertex="1" parent="1"><mxGeometry x="400" y="220" width="64" height="64" as="geometry"/></mxCell><mxCell id="iam" value="IAM ユーザー&#xa;terraform-blog&#xa;S3・CloudFront の権限だけ&#xa;コンソールのログインなし" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;fillColor=#DD344C;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontFamily=Yu Gothic;fontSize=14;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1"><mxGeometry x="400" y="430" width="64" height="64" as="geometry"/></mxCell><mxCell id="region" value="東京リージョン（ap-northeast-1）" style="points=[];outlineConnect=0;html=0;whiteSpace=wrap;fontFamily=Yu Gothic;fontSize=15;fontStyle=1;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_region;strokeColor=#00A4A6;fillColor=none;verticalAlign=top;align=left;spacingLeft=34;fontColor=#00A4A6;dashed=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="615" y="150" width="565" height="460" as="geometry"/></mxCell><mxCell id="site" value="S3（ブログのページ）&#xa;パブリックアクセスはすべてブロック&#xa;暗号化（SSE-S3）&#xa;この配信からの GetObject だけ許可" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;fillColor=#7AA116;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontFamily=Yu Gothic;fontSize=14;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="220" width="64" height="64" as="geometry"/></mxCell><mxCell id="state" value="S3（Terraform の state）&#xa;バージョン管理・暗号化&#xa;use_lockfile でロック&#xa;http は拒否・prevent_destroy" style="sketch=0;outlineConnect=0;fontColor=#232F3E;strokeColor=#ffffff;fillColor=#7AA116;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontFamily=Yu Gothic;fontSize=14;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="700" y="430" width="64" height="64" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Yu Gothic;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="users" target="cf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="OAC（署名つき）&#xa;読み取りだけ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Yu Gothic;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8C4FFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cf" target="site"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="pc" value="自分の PC&#xa;Terraform・Hugo&#xa;（キーは terraform-blog）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=0;fontFamily=Yu Gothic;fontSize=14;aspect=fixed;shape=mxgraph.aws4.client;" vertex="1" parent="1"><mxGeometry x="70" y="560" width="64" height="64" as="geometry"/></mxCell><mxCell id="e3" value="① terraform plan → apply&#xa;（AWS の物を作る・state を読み書き）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Yu Gothic;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#E7157B;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="pc" target="state"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="732" y="592"/></Array></mxGeometry></mxCell><mxCell id="e4" value="② hugo build → aws s3 sync（ページを置く）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Yu Gothic;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7AA116;dashed=1;exitX=0.75;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="pc" target="site"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="118" y="385"/><mxPoint x="732" y="385"/></Array></mxGeometry></mxCell><mxCell id="e5" value="③ キャッシュの無効化" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;fontFamily=Yu Gothic;fontSize=13;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8C4FFF;dashed=1;exitX=0.25;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="pc" target="cf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="86" y="345"/><mxPoint x="432" y="345"/></Array></mxGeometry></mxCell><mxCell id="note" value="4 つの目標でしたこと&#xa;① コスト：サーバーなしの静的サイト。CloudFront の Always free の範囲・PriceClass_200。state の古い版は 90 日で削除&#xa;② 障害に強い：CloudFront のキャッシュから配る。state はバージョン管理で前の版に戻せる&#xa;③ 漏洩させない：S3 は非公開・OAC・HTTPS だけ。IAM は必要な権限だけ。バケット名と state は GitHub に載せない&#xa;④ 容量：S3 は上限を気にしなくてよい。キャッシュでアクセスが増えても S3 の負担が増えにくい" style="text;html=0;whiteSpace=wrap;fontFamily=Yu Gothic;fontSize=15;fontColor=#232F3E;align=left;verticalAlign=top;strokeColor=none;fillColor=none;spacing=4;" vertex="1" parent="1"><mxGeometry x="250" y="680" width="960" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>